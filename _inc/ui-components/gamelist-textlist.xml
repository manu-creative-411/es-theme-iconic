<!-- This component defines the right half of the screen (left half if "Game List Position" is "Left") in "basic" and "detailed" views.

It displays a list of the games of the system being viewed. Its number of rows and font size depend on
the "Game List Rows" option and on the font scale (see "theme-variables.xml"). The panel image has the
row separators baked in, so there is one per number of rows.
-->
<theme>
  <formatVersion>7</formatVersion>
  <view name="basic, detailed">
    <image name="game-list-background" extra="true">
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <zIndex>12</zIndex>
      <linearSmooth>true</linearSmooth>
      <path>./_inc/other/gamelist-rows/${gamelistRows}/gamelist-panel-${logoColorScheme}.png</path>
      <path ifSubset="gamelist-position:left">./_inc/other/gamelist-rows/${gamelistRows}/gamelist-panel-${logoColorScheme}-left.png</path>
    </image>
    <textlist name="gamelist">
      <fontPath>./_inc/fonts/Gilroy-Bold.ttf</fontPath>
      <selectorColor>${gamelistSelectorColor}</selectorColor>
      <selectedColor>${gamelistSelectedColor}</selectedColor>
      <primaryColor>${gamelistPrimaryColor}</primaryColor>
      <secondaryColor>${gamelistSecondaryColor}</secondaryColor>
      <horizontalMargin>0.008333333333333</horizontalMargin>
      <zIndex>17</zIndex>
      <pos>${gamelistX} 0.09</pos>
      <size>0.362 0.7519</size>
      <fontSize>${gamelistFontSize}</fontSize>
      <lines>${gamelistRows}</lines>
      <alignment>left</alignment>
      <scrollSound>./_inc/sounds/scroll.wav</scrollSound>

    </textlist>
  </view>
</theme>
